# Public ElevenLabs Conversational AI agent ID (NOT your API key).
# Find it in ElevenLabs > Agents > your agent > Widget. Leave empty to hide the live panel.
VITE_ELEVENLABS_AGENT_ID=

# Optional public HTTPS appointment page for the 15-minute intro call.
# No credentials. Without a link, Alex clearly offers a contact-form request.
# Validated by Vite before publishing; deliberately not a VITE_ variable.
PORTFOLIO_BOOKING_URL=

# Optional public Supabase client configuration. Use only the public anon key;
# database row-level security must enforce access. Never use a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only contact email credential. Configure in Vercel for deployed forms.
# Vite dev/preview does not run api/contact.js. Never prefix this with VITE_.
RESEND_API_KEY=

# Optional aggregate action counts. Enable the browser only after configuring
# the server keys for your chosen PostHog project. No browser SDK or visitor IDs.
VITE_PORTFOLIO_ANALYTICS_ENABLED=false
# Server-only project ingestion configuration; never use a personal/admin token.
POSTHOG_PROJECT_KEY=
POSTHOG_API_HOST=
