{
  "status": "Awaiting owner selection of the analytics project; not provisioned",
  "governance": "Local proposed event-count definitions, not catalog-approved business metrics",
  "dashboard": {
    "name": "Portfolio Enquiry Outcomes",
    "description": "Aggregate portfolio actions and accepted contact submissions. Repeated actions count; totals do not identify visitors or attribute enquiries to individual conversations."
  },
  "textTile": {
    "body": "Counts show captured actions, not unique people or a conversion funnel. Contact success means the email provider accepted the request; it does not confirm inbox delivery. Privacy preferences, blockers and outages can reduce recorded counts.",
    "layout": {
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 2
    }
  },
  "insights": [
    {
      "name": "Voice connections",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "series": [
            {
              "kind": "EventsNode",
              "event": "portfolio_voice_started",
              "custom_name": "Voice connections",
              "math": "total"
            }
          ],
          "dateRange": {
            "date_from": "-30d"
          },
          "interval": "day",
          "trendsFilter": {
            "display": "Metric",
            "metricSummary": "total",
            "metricShowChange": false
          }
        }
      },
      "layout": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 3
      }
    },
    {
