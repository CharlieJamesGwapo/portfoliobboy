{
  "name": "charlie-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:unit": "node --test && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "npm run build && playwright test",
    "test:release": "npm test && npm run build && VERIFY_DIST=1 python3 -m unittest tests/test_resume.py && playwright test",
    "preview": "vite preview",
    "deploy": "npx vercel build --prod && npx vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.108.2",
    "howler": "^2.2.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.169.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^8.1.5"
  }
}
